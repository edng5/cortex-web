# Copy to .env and fill in. Never commit .env.
# LLM provider: set ONE key. With only GEMINI_API_KEY set, Cortex uses Gemini automatically.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=sk-ant-...
# Force a provider when both keys are set: gemini | claude
# CORTEX_PROVIDER=gemini
# Gemini model (free tier works) and thinking level: minimal | low | medium | high
# GEMINI_MODEL=gemini-flash-lite-latest   (fastest on the free tier; gemini-flash-latest is smarter but slower)
# GEMINI_THINKING=low

# Optional overrides
# Claude model (only used with the claude provider)
CORTEX_MODEL=claude-opus-5-5
# low | medium | high — low keeps voice replies snappy
CORTEX_EFFORT=low
# Requests per IP per 10 minutes on /api/ask
CORTEX_RATE_LIMIT=20
# Hours chat stays off after the third explicit/inappropriate question (two warnings first)
CORTEX_BLOCK_HOURS=24

# ── Login, quotas & audit log ────────────────────────────────────────────────
# Encryption keys for data at rest — generate with: npm run gen-keys (never change once set)
AUTH_ENC_KEY=
AUTH_HMAC_KEY=
# Public URL of the site (used in sign-in links and the Google redirect), e.g. https://edng5.com
ORIGIN=
# Google sign-in (optional): create an OAuth client in Google Cloud Console and add the
# redirect URI  <ORIGIN>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the SQLite database lives (default data/app.db). On Render, point it at the
# persistent disk, e.g. DATABASE_PATH=/var/data/app.db with the disk mounted at /var/data.
# DATABASE_PATH=

# Email sign-in links. Without SMTP_URL: in dev the link is shown on screen; in production
# email sign-in is turned off. Check your settings with: npm run email:test
# Gmail: turn on 2-Step Verification, create an App Password (myaccount.google.com/apppasswords),
# then (the @ in the address becomes %40, and remove the spaces from the 16-letter password):
#   SMTP_URL=smtps://you%40gmail.com:APPPASSWORD@smtp.gmail.com:465
#   EMAIL_FROM="Edward Ng <you@gmail.com>"
SMTP_URL=
EMAIL_FROM="Cortex <no-reply@example.com>"
# Members: comma-separated emails that unlock the hidden Surprise! node
MEMBER_EMAILS=
# YouTube playlist for the members-only Surprise! node (kept out of the repo)
SURPRISE_PLAYLIST_URL=
# Cortex question limits
QUOTA_ANON=5
QUOTA_USER_DAILY=10
# Whitelisted members are unlimited; set this to cap them per day instead.
# QUOTA_MEMBER_DAILY=

# Concurrency: answers generated at once (others queue), and how long a request may wait
CORTEX_MAX_CONCURRENT=8
CORTEX_QUEUE_TIMEOUT_MS=30000
# Dev only (ignored in production builds): fake streamed answers for testing without an API key
# CORTEX_FAKE_LLM=1
